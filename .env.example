# Bubblena Admin — environment variables
# Všechny proměnné jsou POUZE serverové (žádné NEXT_PUBLIC_*),
# do prohlížeče se nikdy nedostanou.

# Backend API base URL
# Development: http://localhost:3001/api
# Production:  https://bubblena-be.onrender.com/api
BE_API_BASE_URL=http://localhost:3001/api

# API klíč backendu (API_KEY z bubblena-be .env) — připojuje ho serverová proxy
BE_API_KEY=your_api_key_here

# Přihlašovací údaje administrátora
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose_a_strong_password

# Tajný klíč pro podpis session cookie — vygenerujte: openssl rand -base64 32
SESSION_SECRET=generate_with_openssl_rand_base64_32
